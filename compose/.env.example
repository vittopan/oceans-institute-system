####################################################################################################
# Copy this file to `.env` locally:
#   cd compose && cp .env.example .env
# Never commit your `.env` (it’s gitignored). Adjust values locally if needed.
####################################################################################################

# --- General ---
# Shown in links/emails; keep the host port in sync with docker-compose.yml
DOMAIN=localhost:18080

# Corteza version tag used by docker-compose (keep these in sync)
# e.g. if docker-compose uses cortezaproject/corteza:2024.9, set VERSION=2024.9
VERSION=2024.9

# --- Database (local dev only) ---
# Matches the Postgres service in docker-compose.yml
DB_DSN=postgres://corteza:corteza@db:5432/corteza?sslmode=disable

# --- Server toggles ---
# Serve web apps from the server container (good for all-in-one local dev)
HTTP_WEBAPP_ENABLED=true

# Persistent audit logging (off for local dev)
ACTIONLOG_ENABLED=false

# --- SMTP (optional; leave commented for local dev) ---
#SMTP_HOST=smtp.example.com:587
#SMTP_USER=postmaster@example.com
#SMTP_PASS=change-me
#SMTP_FROM="Oceans Institute Dev <no-reply@example.com>"

